{
	"name": "tatara-monorepo",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "pnpm -r run build",
		"lint": "biome check .",
		"format": "biome check --write .",
		"typecheck": "pnpm -r --filter \"./packages/*\" run typecheck && tsc -p tsconfig.tools.json",
		"test": "vitest run",
		"e2e": "node e2e/run.ts",
		"versions:update": "node scripts/update-versions.ts",
		"verify": "pnpm lint && pnpm build:libs && pnpm typecheck && pnpm test && pnpm build",
		"new-package": "node scripts/new-package.ts",
		"changeset": "changeset",
		"version-packages": "changeset version && node scripts/sync-versions.ts && pnpm install --no-frozen-lockfile",
		"release": "pnpm build && changeset publish",
		"bench": "node bench/run.ts",
		"build:libs": "pnpm -r --filter \"./packages/*\" --filter \"!@tatara/cli\" --filter \"!create-tatara\" run build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@changesets/cli": "3.0.3",
		"@types/node": "24.19.2",
		"tsdown": "0.23.1",
		"typescript": "7.0.2",
		"vitest": "5.0.4"
	}
}
