{
	"name": "@tatara/cache",
	"version": "0.1.0",
	"description": "tatara cache: one KV contract (get/set/increment/wrap/lock) with memory, Redis and Postgres drivers",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./redis": {
			"types": "./dist/redis.d.mts",
			"import": "./dist/redis.mjs"
		},
		"./postgres": {
			"types": "./dist/postgres.d.mts",
			"import": "./dist/postgres.mjs"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"ioredis": "^6.0.0",
		"pg": "^8.23.1"
	},
	"peerDependenciesMeta": {
		"ioredis": {
			"optional": true
		},
		"pg": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/pg": "8.23.1",
		"ioredis": "^6.0.0",
		"pg": "^8.23.1"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mohammed-bageri/tatara-cli.git",
		"directory": "packages/cache"
	},
	"homepage": "https://github.com/mohammed-bageri/tatara-cli#readme",
	"bugs": {
		"url": "https://github.com/mohammed-bageri/tatara-cli/issues"
	}
}
