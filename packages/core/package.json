{
	"name": "@tatara/core",
	"version": "0.1.2",
	"description": "tatara core: commands, flags, lifecycle, readiness, logger options",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./html": {
			"types": "./dist/html.d.mts",
			"import": "./dist/html.mjs"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"zod": "^4.6.7",
		"pino": "^10.4.0",
		"sanitize-html": "^2.18.1"
	},
	"devDependencies": {
		"zod": "^4.6.7",
		"pino": "^10.4.0",
		"sanitize-html": "^2.18.1",
		"@types/sanitize-html": "^2.16.2"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mohammed-bageri/tatara-cli.git",
		"directory": "packages/core"
	},
	"homepage": "https://github.com/mohammed-bageri/tatara-cli#readme",
	"bugs": {
		"url": "https://github.com/mohammed-bageri/tatara-cli/issues"
	},
	"peerDependenciesMeta": {
		"sanitize-html": {
			"optional": true
		}
	}
}
