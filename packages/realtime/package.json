{
	"name": "@tatara/realtime",
	"version": "0.1.0",
	"description": "tatara realtime: socket.io with ticket auth, user and org rooms, module channels and cross-process publishing",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./commands": {
			"types": "./dist/commands.d.mts",
			"import": "./dist/commands.mjs"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@tatara/core": "^0.1.2",
		"socket.io": "^4.8.4",
		"@socket.io/redis-adapter": "^8.3.0",
		"@socket.io/redis-emitter": "^5.1.0",
		"ioredis": "^6.0.0",
		"zod": "^4.6.7"
	},
	"peerDependenciesMeta": {
		"@socket.io/redis-adapter": {
			"optional": true
		},
		"@socket.io/redis-emitter": {
			"optional": true
		},
		"ioredis": {
			"optional": true
		}
	},
	"devDependencies": {
		"@tatara/core": "workspace:^",
		"socket.io": "^4.8.4",
		"socket.io-client": "^4.8.4",
		"@socket.io/redis-adapter": "^8.3.0",
		"@socket.io/redis-emitter": "^5.1.0",
		"ioredis": "^6.0.0",
		"zod": "^4.6.7",
		"pino": "^10.4.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mohammed-bageri/tatara-cli.git",
		"directory": "packages/realtime"
	},
	"homepage": "https://github.com/mohammed-bageri/tatara-cli#readme",
	"bugs": {
		"url": "https://github.com/mohammed-bageri/tatara-cli/issues"
	},
	"tatara": {
		"commands": [
			{
				"import": "@tatara/realtime/commands",
				"factory": "realtimeCommands",
				"args": {
					"realtime": "#core/realtime/index"
				}
			}
		]
	}
}
