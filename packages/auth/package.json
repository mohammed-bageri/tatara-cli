{
	"name": "@tatara/auth",
	"version": "0.1.1",
	"description": "tatara auth: principal middleware, guards, OpenAPI merge, dev outbox and test helpers for better-auth",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
