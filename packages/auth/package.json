			"types": "./dist/testing.d.mts",
			"import": "./dist/testing.mjs"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"better-auth": "^1.7.8",
		"hono": "^4.13.13",
		"@hono/zod-openapi": "^1.6.3",
