		"@tatara/core": "^0.1.1"
	},
	"devDependencies": {
		"better-auth": "^1.7.8",
		"hono": "^4.13.13",
		"@hono/zod-openapi": "^1.6.3",
		"@tatara/http": "workspace:^",
		"@tatara/core": "workspace:^",
		"@hono/node-server": "^2.1.5",
		"@scalar/hono-api-reference": "^0.12.12",
		"pino": "^10.4.0",
		"zod": "^4.6.7"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mohammed-bageri/tatara-cli.git",
