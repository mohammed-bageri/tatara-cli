{
	"name": "@tatara/email",
	"version": "0.1.0",
	"description": "tatara email: SMTP or console mailer",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./commands": {
			"types": "./dist/commands.d.mts",
			"import": "./dist/commands.mjs"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"nodemailer": "^10.1.1",
		"@tatara/core": "^0.1.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"nodemailer": "^10.1.1",
		"@tatara/core": "workspace:^",
		"pino": "^10.4.0",
		"@types/nodemailer": "^8.0.2",
		"zod": "^4.6.7"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mohammed-bageri/tatara-cli.git",
		"directory": "packages/email"
	},
	"homepage": "https://github.com/mohammed-bageri/tatara-cli#readme",
	"bugs": {
		"url": "https://github.com/mohammed-bageri/tatara-cli/issues"
	},
	"tatara": {
		"commands": [
			{
				"import": "@tatara/email/commands",
				"factory": "emailCommands",
				"args": {
					"sendEmail": "#core/email/send"
				}
			}
		]
	}
}
