{
	"name": "@tatara/observability",
	"version": "0.1.0",
	"description": "tatara observability: OpenTelemetry traces and metrics over OTLP, Hono tracing, trace ids in logs",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./hooks": {
			"types": "./dist/hooks.d.mts",
			"import": "./dist/hooks.mjs"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/sdk-node": "^0.300.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
		"@opentelemetry/sdk-metrics": "^3.0.0",
		"@opentelemetry/auto-instrumentations-node": "^0.82.0",
		"@opentelemetry/resources": "^3.0.0",
		"@hono/otel": "^1.3.0",
		"@tatara/core": "^0.1.2",
		"@opentelemetry/sdk-trace": "^3.0.0",
		"hono": "^4.13.13",
		"import-in-the-middle": "^3.5.3",
		"@opentelemetry/instrumentation": "^0.300.0"
	},
	"devDependencies": {
		"@opentelemetry/api": "^1.10.0",
		"@opentelemetry/sdk-node": "^0.300.0",
		"@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
		"@opentelemetry/exporter-metrics-otlp-http": "^0.300.0",
		"@opentelemetry/sdk-metrics": "^3.0.0",
		"@opentelemetry/auto-instrumentations-node": "^0.82.0",
		"@opentelemetry/resources": "^3.0.0",
		"@hono/otel": "^1.3.0",
		"@tatara/core": "workspace:^",
		"hono": "^4.13.13",
		"pino": "^10.4.0",
		"@opentelemetry/sdk-trace": "^3.0.0",
		"import-in-the-middle": "^3.5.3",
		"@opentelemetry/instrumentation": "^0.300.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mohammed-bageri/tatara-cli.git",
		"directory": "packages/observability"
	},
	"homepage": "https://github.com/mohammed-bageri/tatara-cli#readme",
	"bugs": {
		"url": "https://github.com/mohammed-bageri/tatara-cli/issues"
	}
}
