{
	"name": "@tatara/keycloak",
	"version": "0.1.0",
	"description": "tatara Keycloak: a better-auth plugin that accepts Keycloak access tokens",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./testing": {
			"types": "./dist/testing.d.mts",
			"import": "./dist/testing.mjs"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"better-auth": "^1.7.8",
		"jose": "^6.2.12",
		"zod": "^4.6.7",
		"@tatara/auth": "^0.1.0",
		"@tatara/core": "^0.1.0"
	},
	"devDependencies": {
		"better-auth": "^1.7.8",
		"jose": "^6.2.12",
		"zod": "^4.6.7",
		"@tatara/auth": "workspace:^",
		"@tatara/core": "workspace:^",
		"@tatara/http": "workspace:^",
		"hono": "^4.13.13",
		"@hono/zod-openapi": "^1.6.3",
		"pino": "^10.4.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mohammed-bageri/tatara-cli.git",
		"directory": "packages/keycloak"
	},
	"homepage": "https://github.com/mohammed-bageri/tatara-cli#readme",
	"bugs": {
		"url": "https://github.com/mohammed-bageri/tatara-cli/issues"
	}
}
