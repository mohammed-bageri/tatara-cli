{
	"name": "@tatara/authz",
	"version": "0.3.1",
	"description": "tatara authz: permission catalog, resolver, guards, role and member services, and routes",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./testing": {
			"types": "./dist/testing.d.mts",
			"import": "./dist/testing.mjs"
		},
		"./prisma": {
			"types": "./dist/prisma.d.mts",
			"import": "./dist/prisma.mjs"
		},
		"./drizzle": {
			"types": "./dist/drizzle.d.mts",
			"import": "./dist/drizzle.mjs"
		},
		"./commands": {
			"types": "./dist/commands.d.mts",
			"import": "./dist/commands.mjs"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"hono": "^4.13.13",
		"@hono/zod-openapi": "^1.6.3",
		"@tatara/http": "^0.1.2",
		"@tatara/auth": "^0.2.0",
		"@tatara/db": "^0.2.2",
		"drizzle-orm": "^0.45.4",
		"@tatara/core": "^0.1.2",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"hono": "^4.13.13",
		"@hono/zod-openapi": "^1.6.3",
		"@tatara/http": "workspace:^",
		"@tatara/auth": "workspace:^",
		"@tatara/core": "workspace:^",
		"@hono/node-server": "^2.1.5",
		"@scalar/hono-api-reference": "^0.12.12",
		"better-auth": "^1.7.8",
		"pino": "^10.4.0",
		"zod": "^4.6.7",
		"@tatara/db": "workspace:^",
		"drizzle-orm": "^0.45.4"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mohammed-bageri/tatara-cli.git",
		"directory": "packages/authz"
	},
	"homepage": "https://github.com/mohammed-bageri/tatara-cli#readme",
	"bugs": {
		"url": "https://github.com/mohammed-bageri/tatara-cli/issues"
	},
	"peerDependenciesMeta": {
		"drizzle-orm": {
			"optional": true
		}
	},
	"tatara": {
		"commands": [
			{
				"import": "@tatara/authz/commands",
				"factory": "authzCommands",
				"args": {
					"authz": "#core/authz/index"
				}
			}
		],
		"seeds": [
			{
				"import": "@tatara/authz/commands",
				"factory": "authzSeeds",
				"args": {
					"authz": "#core/authz/index"
				}
			}
		]
	}
}
