{
	"name": "@tatara/storage",
	"version": "0.1.0",
	"description": "tatara storage: a small Storage contract with local and S3 drivers",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./s3": {
			"types": "./dist/s3.d.mts",
			"import": "./dist/s3.mjs"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"@aws-sdk/client-s3": "^3.1152.0",
		"@aws-sdk/s3-request-presigner": "^3.1152.0"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "^3.1152.0",
		"@aws-sdk/s3-request-presigner": "^3.1152.0"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mohammed-bageri/tatara-cli.git",
		"directory": "packages/storage"
	},
	"homepage": "https://github.com/mohammed-bageri/tatara-cli#readme",
	"bugs": {
		"url": "https://github.com/mohammed-bageri/tatara-cli/issues"
	},
	"peerDependenciesMeta": {
		"@aws-sdk/client-s3": {
			"optional": true
		},
		"@aws-sdk/s3-request-presigner": {
			"optional": true
		}
	}
}
