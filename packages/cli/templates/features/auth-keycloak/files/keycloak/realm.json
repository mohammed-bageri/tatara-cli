{
	"realm": "__APP_NAME__",
	"enabled": true,
	"displayName": "__APP_NAME__ (development)",
	"sslRequired": "none",
	"accessTokenLifespan": 900,
	"registrationAllowed": false,
	"roles": {
		"realm": [
			{
				"name": "user",
				"description": "Signed-in user"
			},
			{
				"name": "admin",
				"description": "Administrator"
			}
		]
	},
	"clients": [
		{
			"clientId": "__APP_NAME__-api",
			"name": "__APP_NAME__ API (token audience)",
			"enabled": true,
			"publicClient": false,
			"bearerOnly": true,
			"standardFlowEnabled": false,
			"directAccessGrantsEnabled": false
		},
		{
			"clientId": "__APP_NAME__-web",
			"name": "__APP_NAME__ web (public, PKCE)",
			"enabled": true,
			"publicClient": true,
			"standardFlowEnabled": true,
			"directAccessGrantsEnabled": true,
			"redirectUris": [
				"http://localhost:5173/*",
				"http://localhost:3000/*"
			],
			"webOrigins": [
				"+"
			],
			"attributes": {
				"pkce.code.challenge.method": "S256",
				"post.logout.redirect.uris": "+"
			},
			"protocolMappers": [
				{
					"name": "api-audience",
					"protocol": "openid-connect",
					"protocolMapper": "oidc-audience-mapper",
					"config": {
						"included.client.audience": "__APP_NAME__-api",
						"access.token.claim": "true",
						"id.token.claim": "false"
					}
				},
				{
					"name": "realm-roles",
					"protocol": "openid-connect",
					"protocolMapper": "oidc-usermodel-realm-role-mapper",
					"config": {
						"claim.name": "roles",
						"multivalued": "true",
						"jsonType.label": "String",
						"access.token.claim": "true",
						"id.token.claim": "false",
						"userinfo.token.claim": "false"
					}
				}
			]
		}
	],
	"users": [
		{
			"username": "alice",
			"email": "alice@example.com",
			"emailVerified": true,
			"firstName": "Alice",
			"lastName": "Admin",
			"enabled": true,
			"credentials": [
				{
					"type": "password",
					"value": "alice",
					"temporary": false
				}
			],
			"realmRoles": [
				"user",
				"admin"
			]
		},
		{
			"username": "bob",
			"email": "bob@example.com",
			"emailVerified": true,
			"firstName": "Bob",
			"lastName": "User",
			"enabled": true,
			"credentials": [
				{
					"type": "password",
					"value": "bob",
					"temporary": false
				}
			],
			"realmRoles": [
				"user"
			]
		}
	],
	"organizationsEnabled": true,
	"organizations": [
		{
			"name": "Demo School",
			"alias": "demo-school",
			"enabled": true,
			"description": "Dev organization: alice and bob are members",
			"domains": [
				{
					"name": "demo-school.example",
					"verified": false
				}
			],
			"members": [
				{
					"username": "alice",
					"membershipType": "UNMANAGED"
				},
				{
					"username": "bob",
					"membershipType": "UNMANAGED"
				}
			]
		}
	]
}
