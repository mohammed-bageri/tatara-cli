{
	"name": "@tatara/db",
	"version": "0.2.1",
	"description": "tatara database helpers: ids, seeds, per-driver admin and per-ORM migrations",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./postgres": {
			"types": "./dist/postgres.d.mts",
			"import": "./dist/postgres.mjs"
		},
		"./mariadb": {
			"types": "./dist/mariadb.d.mts",
			"import": "./dist/mariadb.mjs"
		},
		"./mysql2": {
			"types": "./dist/mysql2.d.mts",
			"import": "./dist/mysql2.mjs"
		},
		"./prisma": {
			"types": "./dist/prisma.d.mts",
			"import": "./dist/prisma.mjs"
		},
		"./drizzle-postgres": {
			"types": "./dist/drizzle-postgres.d.mts",
			"import": "./dist/drizzle-postgres.mjs"
		},
		"./drizzle-mysql": {
			"types": "./dist/drizzle-mysql.d.mts",
			"import": "./dist/drizzle-mysql.mjs"
		},
		"./commands": {
			"types": "./dist/commands.d.mts",
			"import": "./dist/commands.mjs"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"pg": "^8.23.1",
		"mariadb": "^3.4.5",
		"mysql2": "^3.24.6",
		"drizzle-orm": "^0.45.4",
		"@tatara/core": "^0.2.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"pg": "^8.23.1",
		"mariadb": "^3.4.5",
		"mysql2": "^3.24.6",
		"drizzle-orm": "^0.45.4",
		"@tatara/core": "workspace:^",
		"@types/pg": "8.23.1",
		"pino": "^10.4.0",
		"zod": "^4.6.7"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mohammed-bageri/tatara-cli.git",
		"directory": "packages/db"
	},
	"homepage": "https://github.com/mohammed-bageri/tatara-cli#readme",
	"bugs": {
		"url": "https://github.com/mohammed-bageri/tatara-cli/issues"
	},
	"peerDependenciesMeta": {
		"pg": {
			"optional": true
		},
		"mariadb": {
			"optional": true
		},
		"mysql2": {
			"optional": true
		},
		"drizzle-orm": {
			"optional": true
		}
	},
	"tatara": {
		"commands": [
			{
				"import": "@tatara/db/commands",
				"factory": "dbCommands",
				"args": {
					"env": "#core/config/env",
					"migrateDatabase": "#core/db/migrate",
					"dropAllTables": "#core/db/admin",
					"seeds": "#generated/seeds"
				}
			}
		]
	}
}
