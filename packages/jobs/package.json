{
	"name": "@tatara/jobs",
	"version": "0.3.0",
	"description": "tatara jobs: consumers, schedules, a typed producer, and worker and cron runners over inline, Postgres, BullMQ and Kafka drivers",
	"type": "module",
	"license": "MIT",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./bullmq": {
			"types": "./dist/bullmq.d.mts",
			"import": "./dist/bullmq.mjs"
		},
		"./postgres": {
			"types": "./dist/postgres.d.mts",
			"import": "./dist/postgres.mjs"
		},
		"./kafka": {
			"types": "./dist/kafka.d.mts",
			"import": "./dist/kafka.mjs"
		},
		"./commands": {
			"types": "./dist/commands.d.mts",
			"import": "./dist/commands.mjs"
		}
	},
	"files": [
		"dist",
		"src",
		"!src/**/*.test.ts"
	],
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"bullmq": "^6.3.15",
		"ioredis": "^6.0.0",
		"croner": "^10.0.1",
		"zod": "^4.6.7",
		"@tatara/core": "^0.1.2",
		"kafkajs": "^2.2.4"
	},
	"devDependencies": {
		"bullmq": "^6.3.15",
		"ioredis": "^6.0.0",
		"croner": "^10.0.1",
		"zod": "^4.6.7",
		"@tatara/core": "workspace:^",
		"pino": "^10.4.0",
		"kafkajs": "^2.2.4",
		"pg": "^8.23.1",
		"@types/pg": "8.23.1"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mohammed-bageri/tatara-cli.git",
		"directory": "packages/jobs"
	},
	"homepage": "https://github.com/mohammed-bageri/tatara-cli#readme",
	"bugs": {
		"url": "https://github.com/mohammed-bageri/tatara-cli/issues"
	},
	"tatara": {
		"commands": [
			{
				"import": "@tatara/jobs/commands",
				"factory": "jobsCommands",
				"args": {
					"jobs": "#core/jobs/index",
					"scheduleRunner": "#apps/cron/runner"
				}
			}
		]
	},
	"peerDependenciesMeta": {
		"bullmq": {
			"optional": true
		},
		"ioredis": {
			"optional": true
		},
		"kafkajs": {
			"optional": true
		}
	}
}
