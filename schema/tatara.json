{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://raw.githubusercontent.com/mohammed-bageri/tatara-cli/main/schema/tatara.json",
	"title": "tatara.json",
	"description": "What a tatara app was created with; read by the tatara CLI's generators.",
	"type": "object",
	"required": [
		"version",
		"name",
		"orm",
		"database",
		"auth",
		"authMethods",
		"addons",
		"packageManager"
	],
	"properties": {
		"$schema": { "type": "string" },
		"version": { "type": "string", "description": "tatara version the app was created with" },
		"name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
		"orm": { "enum": ["drizzle", "prisma", "none"] },
		"database": { "enum": ["postgres", "mysql", "none"] },
		"auth": { "enum": ["better-auth", "none"] },
		"authMethods": {
			"type": "array",
			"items": { "enum": ["email-otp", "phone-otp", "password", "keycloak", "orgs"] },
			"uniqueItems": true
		},
		"addons": {
			"type": "array",
			"items": { "enum": ["authz", "jobs", "cache", "admin", "storage", "email", "i18n"] },
			"uniqueItems": true
		},
		"packageManager": { "enum": ["pnpm", "npm", "bun"] },
		"generated": {
			"description": "Written by tatara new / tatara upgrade: the CLI version and a hash of each framework file it wrote. Used by tatara upgrade.",
			"type": "object",
			"properties": {
				"cli": { "type": "string" },
				"files": { "type": "object", "additionalProperties": { "type": "string" } }
			},
			"required": ["cli", "files"],
			"additionalProperties": false
		},
		"ejected": {
			"description": "Written by tatara eject: each package copied into src/ejected, with the version it was ejected at. tatara upgrade leaves these alone.",
			"type": "object",
			"additionalProperties": { "type": "string" }
		}
	},
	"additionalProperties": false
}
